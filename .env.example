# Application
APP_ENVIRONMENT=development
DEBUG=false

# LLM Configuration (OpenAI / Groq / Ollama / OpenAI-compatible endpoint)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_MAX_STEPS=50

# Database & pgvector Configuration
# Option 1: SQLite (default for local development & offline testing)
DATABASE_URL=sqlite+aiosqlite:///talos.db

# Option 2: Local PostgreSQL with pgvector
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Option 3: Supabase PostgreSQL with pgvector
# DATABASE_URL=postgresql+asyncpg://postgres:YourPassword@db.your-project.supabase.co:5432/postgres

# Gemini Embedding Configuration
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

# Worker & Queue Pool Configuration
WORKER_CONCURRENCY=4
TASK_QUEUE_MAX_SIZE=100
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=3.0
MAX_RETAINED_TASK_EVENTS=1000

# Docker Sandbox Container Hardening
WORKSPACE_MEM_LIMIT=512m
WORKSPACE_PIDS_LIMIT=256
WORKSPACE_READ_ONLY=true
WORKSPACE_NETWORK_MODE=none
WORKSPACE_USER=1000:1000
