# Application
APP_ENVIRONMENT=development
DEBUG=false

# LLM Configuration
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_MAX_STEPS=50

# Database & pgvector Configuration
# SQLite (default for local development & offline testing):
DATABASE_URL=sqlite+aiosqlite:///talos.db

# PostgreSQL with pgvector (for production vector database):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/talos_db

# Gemini Embedding Configuration
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072




